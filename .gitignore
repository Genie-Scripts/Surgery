data/raw/
data/normalized/
data/llm_cache/

# ローカル実名版の出力先
local/

# 補助対応表（実名↔匿名 ID）
config/master_key.csv
config/master_key.*.csv
config/peers.csv

# サンプル CSV（ルート直下に置かれた状態のもの。匿名化済みでも安全側で除外）
/anonymized_data*.csv

# Streamlit secrets
.streamlit/secrets.toml

