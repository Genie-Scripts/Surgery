# --- 個人情報・機微データ（コミット厳禁）---
# 生データ・匿名化済みデータの両方を ignore（誤コミット防止のため安全側）
data/raw/
data/normalized/
data/llm_cache/

# ローカル実名版の出力先
local/

# 補助対応表（実名↔匿名 ID）
config/master_key.csv
config/master_key.*.csv
config/peers.csv

# 集計の中間生成物（parquet は実データ由来で除外）。
# aggregated CSV は術者名キー（個人別の月次集計など）を含みうるため、
# PUBLIC リポジトリでは安全側で全除外する（必要な匿名化済み CSV は force-add で個別に）。
data/aggregated/*.parquet
data/aggregated/*.csv

# data/ 直下の使い捨て探索スクリプト（実名データを読み込むため追跡しない）
data/*.py

# サンプル CSV（ルート直下に置かれた状態のもの。匿名化済みでも安全側で除外）
/anonymized_data*.csv

# Streamlit secrets
.streamlit/secrets.toml

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# --- macOS / IDE / 個人開発ツール ---
.DS_Store
.vscode/
.idea/
*.swp
.claude/
